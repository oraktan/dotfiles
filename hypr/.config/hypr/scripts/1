#alias yy='bash -c "cat \"\$1\" | wl-copy" --'
# yy fonksiyonu: Dosya içeriğini kopyalar
yy() {
    if [ -n "$1" ]; then
        if [ -f "$1" ]; then
            cat "$1" | wl-copy
            echo "✅ '$1' panoya kopyalandı."
        else
            echo "❌ Hata: '$1' bir dosya değil."
        fi
    else
        echo "💡 Kullanım: yy dosya_adı"
    fi
}

alias duf='du -sh * 2>/dev/null | sort -h'

# Not ekleme fonksiyonu (Tarih damgalı)
n() {
    local NOT_DOSYASI="$HOME/dotfiles/not/.config/notlarim/notlarim.txt"
    
    # Eğer n yazıp yanına bir şey yazmazsan sadece notları gösterir
    if [ -z "$1" ]; then
        echo "--- Mevcut Notların ---"
        cat "$NOT_DOSYASI"
    else
        # Tarih formatı: [17-02-2026 17:15]
        local TARIH=$(date '+[%d-%m-%Y %H:%M]')
        echo "$TARIH $*" >> "$NOT_DOSYASI"
        echo "Not eklendi: $*"
    fi
}

