 /* wallust template - colors-rofi */

* {
active-background: #574A3C;
active-foreground: #ECF1E4;
normal-background: #1B1C1C;
normal-foreground: #ECF1E4;
urgent-background: #C29F60;
urgent-foreground: #ECF1E4;

alternate-active-background: #1A1C1C;
alternate-active-foreground: #ECF1E4;
alternate-normal-background: #1B1C1C;
alternate-normal-foreground: #ECF1E4;
alternate-urgent-background: #1B1C1C;
alternate-urgent-foreground: #ECF1E4;

selected-active-background: #574A3C;
selected-active-foreground: #1B1C1C;
selected-normal-background: #574A3C;
selected-normal-foreground: #1B1C1C;
selected-urgent-background: #1A1C1C;
selected-urgent-foreground: #1B1C1C;

background-color: #1B1C1C;
background: rgba(0,0,0,0.7);
foreground: #ECF1E4;
border-color: #574A3C;

color0: #424242;
color1: #131515;
color2: #131515;
color3: #131515;
color4: #41382D;
color5: #927748;
color6: #96A286;
color7: #DBE3D0;
color8: #999F92;
color9: #1A1C1C;
color10: #1A1C1C;
color11: #1A1C1C;
