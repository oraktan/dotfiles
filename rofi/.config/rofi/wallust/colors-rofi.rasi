 /* wallust template - colors-rofi */

* {
active-background: #A9A99D;
active-foreground: #E3E3DF;
normal-background: #000001;
normal-foreground: #E3E3DF;
urgent-background: #ACAC9F;
urgent-foreground: #E3E3DF;

alternate-active-background: #7C7267;
alternate-active-foreground: #E3E3DF;
alternate-normal-background: #000001;
alternate-normal-foreground: #E3E3DF;
alternate-urgent-background: #000001;
alternate-urgent-foreground: #E3E3DF;

selected-active-background: #ACAC9F;
selected-active-foreground: #E3E3DF;
selected-normal-background: #ACAC9F;
selected-normal-foreground: #E3E3DF;
