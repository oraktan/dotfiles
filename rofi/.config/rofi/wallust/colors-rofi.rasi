 /* wallust template - colors-rofi */

* {
active-background: #5F7095;
active-foreground: #F0F1F4;
normal-background: #111114;
normal-foreground: #F0F1F4;
urgent-background: #A9729F;
urgent-foreground: #F0F1F4;

alternate-active-background: #46526F;
alternate-active-foreground: #F0F1F4;
